# Copiar a .env y ajustar. Ningún valor de este fichero debe estar hardcodeado en el código.

# --- Rutas (puerto RoutingProvider) ---
# OSRM público para el prototipo (respetar ~1 req/s).
# Al pasar a OSRM autoalojado: cambiar solo esta variable.
OSRM_URL=https://router.project-osrm.org

# --- Persistencia (puerto PriceStore) ---
DB_PATH=data/repostaje.db

# --- Ingesta: Geoportal de Carburantes (MITECO) ---
GEOPORTAL_URL=https://sedeaplicaciones.minetur.gob.es/ServiciosRESTCarburantes/PrestacionesServicios/EstacionesTerrestres/

# El Ministerio corta la conexión según User-Agent. Mandar uno de navegador.
GEOPORTAL_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/125.0.0.0 Safari/537.36

# Snapshots crudos de la respuesta de la API, para desarrollar y testear sin red.
SNAPSHOT_DIR=data/snapshots
